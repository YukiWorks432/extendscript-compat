{
  "name": "extendscript-compat",
  "version": "0.2.0",
  "description": "Build-time and runtime compatibility fixes for Adobe ExtendScript",
  "homepage": "https://github.com/YukiWorks432/extendscript-compat#readme",
  "bugs": {
    "url": "https://github.com/YukiWorks432/extendscript-compat/issues"
  },
  "license": "MIT",
  "author": "YukiWorks432",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukiWorks432/extendscript-compat.git"
  },
  "files": [
    "src",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "runtime",
    "THIRD-PARTY-LICENSES.txt",
    "docs/build-compatibility.md",
    "docs/build-compatibility.ja.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./rollup": {
      "types": "./src/rollup.d.ts",
      "default": "./src/rollup.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./unit-value": {
      "types": "./runtime/unit-value.d.ts",
      "default": "./runtime/unit-value.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0 .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rollup": "^4.65.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "rollup": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
